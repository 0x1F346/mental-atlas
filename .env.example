# Copy this file to `.env`. Every variable the app reads is listed here; no value is a secret.
# Commented lines show the default. Secrets are listed with no value.

# ATLAS_ENVIRONMENT=development

# Postgres. The app role cannot bypass row-level security; the owner role runs migrations.
# ATLAS_DATABASE_URL=postgresql+psycopg://atlas_app:atlas_app@localhost:54329/atlas
# ATLAS_DATABASE_OWNER_URL=postgresql+psycopg://atlas_owner:atlas_owner@localhost:54329/atlas

# S3-compatible object storage (MinIO locally; the local defaults match docker-compose.yml).
# ATLAS_S3_ENDPOINT_URL=http://localhost:9100
# ATLAS_S3_REGION=us-east-1
# ATLAS_S3_BUCKET=atlas
# ATLAS_S3_ACCESS_KEY=
# ATLAS_S3_SECRET_KEY=
# ATLAS_SIGNED_LINK_TTL_SECONDS=300
# ATLAS_BLOB_STORE=s3

# Providers: "fake" makes no outside call; "live" needs the keys below.
# ATLAS_PROVIDERS=fake
# ATLAS_ANTHROPIC_API_KEY=
# ATLAS_ELEVENLABS_API_KEY=
# ATLAS_EMBEDDING_API_KEY=

# Model ids. Confirm against live documentation before changing.
# ATLAS_EXTRACTION_MODEL=claude-sonnet-5-5
# ATLAS_SMALL_MODEL=claude-haiku-5-5
# ATLAS_TRANSCRIPTION_MODEL=scribe_v3
# ATLAS_TRANSCRIPTION_MODE=direct
# ATLAS_TRANSCRIPTION_ZERO_RETENTION=false
# ATLAS_EMBEDDING_MODEL=fake-embedding
# ATLAS_EMBEDDING_DIMENSION=1024

# Pipeline thresholds.
# ATLAS_SPEAKER_ROLE_CONFIDENCE_THRESHOLD=0.9
# ATLAS_MATCH_ACCEPT_THRESHOLD=0.90
# ATLAS_MATCH_REVIEW_THRESHOLD=0.75

# Sign-in. Set ATLAS_COOKIE_SECURE=true whenever the app is served over HTTPS.
# ATLAS_SESSION_COOKIE_NAME=atlas_session
# ATLAS_SESSION_TTL_HOURS=336
# ATLAS_COOKIE_SECURE=false
# ATLAS_LOGIN_RATE_LIMIT_PER_MINUTE=5
# ATLAS_SEED_USER_EMAIL=owner@example.com
# ATLAS_SEED_USER_PASSWORD=

# ATLAS_WEB_ORIGIN=http://localhost:5173

# Worker.
# ATLAS_WORKER_NAME=worker-1
# ATLAS_WORKER_POLL_SECONDS=1.0
# ATLAS_JOB_LEASE_SECONDS=900
# ATLAS_JOB_MAX_ATTEMPTS=3
