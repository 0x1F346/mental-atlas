          },
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SpeakerRole"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "label",
          "role",
          "method",
          "confidence",
          "first_start_ms"
        ],
        "title": "SpeakerOut",
        "type": "object"
      },
      "SpeakerRole": {
        "description": "Who a voice belongs to.",
        "enum": [
          "self",
          "therapist",
          "other"
        ],
        "title": "SpeakerRole",
        "type": "string"
      },
      "SpeakerRoles": {
        "properties": {
          "roles": {
            "additionalProperties": {
              "$ref": "#/components/schemas/SpeakerRole"
            },
            "propertyNames": {
              "format": "uuid"
            },
            "title": "Roles",
            "type": "object"
          }
        },
        "required": [
          "roles"
        ],
        "title": "SpeakerRoles",
        "type": "object"
      },
      "Stage": {
        "enum": [
          "media",
          "transcribe",
          "segment_text",
          "speakers",
          "statements",
          "concepts",
          "commit",
          "embed",
          "place"
        ],
        "title": "Stage",
        "type": "string"
      },
      "StageOut": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "stage",
          "status",
          "error",
          "started_at",
          "finished_at"
        ],
        "title": "StageOut",
        "type": "object"
      },
      "StatementKind": {
        "description": "What sort of thing a statement is.",
        "enum": [
          "report",
          "feeling",
          "reflection",
          "intention",
          "observation"
        ],
        "title": "StatementKind",
        "type": "string"
      },
      "Status": {
        "description": "How well established a node or relationship is. Computed from evidence, never set by hand.",
        "enum": [
          "stated",
          "observed",
          "hypothesis"
        ],
        "title": "Status",
        "type": "string"
      },
      "TranscriptOut": {
        "properties": {
          "segments": {
            "items": {
              "$ref": "#/components/schemas/SegmentOut"
            },
            "title": "Segments",
            "type": "array"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          },
          "speakers": {
            "items": {
              "$ref": "#/components/schemas/SpeakerOut"
            },
            "title": "Speakers",
            "type": "array"
          }
        },
        "required": [
          "source_id",
          "speakers",
          "segments"
        ],
        "title": "TranscriptOut",
        "type": "object"
      },
      "UploadTarget": {
        "properties": {
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Headers",
            "type": "object"
          },
          "method": {
            "default": "PUT",
            "title": "Method",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "headers",
          "expires_in"
        ],
        "title": "UploadTarget",
        "type": "object"
      }
    }
  },
